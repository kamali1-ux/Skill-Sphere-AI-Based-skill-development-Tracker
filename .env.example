# .env.example
# Copy this file to .env and fill in real values for your local or production environment.
# Do NOT commit your real .env file — it is already excluded in .gitignore.

# ─── MySQL Database ──────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/skillsphere_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ─── JWT Security ─────────────────────────────────────────────────────────────
# Use a long, random string (64+ characters) in production.
JWT_SECRET=ReplaceThisWithALongRandomSecretStringAtLeast64CharactersLongForSecurity

# ─── Python AI Service ────────────────────────────────────────────────────────
# URL where the Flask AI service is running.
AI_SERVICE_URL=http://localhost:5000

# ─── Spring Boot Server ───────────────────────────────────────────────────────
SERVER_PORT=8080
